Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: arx_waypoints/MappingPanel
  Name: "\u5EFA\u56FE\u64CD\u4F5C"
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Background Color: 45; 45; 45
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/PointCloud2
    Name: "\u53CC\u96F7\u8FBE\u8054\u5408 LIO \u70B9\u4E91"
    Enabled: true
    Topic:
      Value: /pb/rviz/lio_cloud_map
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 2
    Size (m): 0.025
    Style: Points
    Color Transformer: FlatColor
    Color: 0; 255; 120
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Bottom obstacle observations
    Enabled: false
    Topic:
      Value: /pb/bottom/nav_mark
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 2
    Size (m): 0.025
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 130; 0
    Decay Time: 0.4
  - Class: rviz_default_plugins/PointCloud2
    Name: "\u540E\u96F7\u8FBE\u969C\u788D\u89C2\u6D4B"
    Enabled: true
    Topic:
      Value: /pb/head/nav_mark
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 2
    Size (m): 0.025
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 45; 45
    Decay Time: 0.4
  - Class: rviz_default_plugins/PointCloud2
    Name: "\u540E\u96F7\u8FBE\u53BB\u7578\u53D8\u70B9\u4E91"
    Enabled: true
    Topic:
      Value: /pb/rviz/rear_cloud_map
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 2
    Size (m): 0.025
    Style: Points
    Color Transformer: FlatColor
    Color: 0; 255; 0
    Decay Time: 0
  - Class: rviz_default_plugins/MarkerArray
    Name: Map
    Enabled: true
    Topic:
      Value: /pb/display/map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 2
  - Class: rviz_default_plugins/MarkerArray
    Name: Global costmap
    Enabled: true
    Topic:
      Value: /pb/display/global
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 2
  - Class: rviz_default_plugins/MarkerArray
    Name: Local costmap
    Enabled: false
    Topic:
      Value: /pb/display/local
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 2
  - Class: arx_waypoints/ForegroundPolygon
    Name: Actual CAD footprint
    Enabled: true
    Topic:
      Value: /pb/rviz/footprint
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 2
    Color: 255; 255; 0
    Alpha: 1.0
    Draw Priority: 1
    Frame Locked: true
  - Class: arx_waypoints/ForegroundPolygon
    Name: Padded CAD planner footprint
    Enabled: true
    Topic:
      Value: /pb/rviz/padded_footprint
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 2
    Color: 255; 0; 255
    Alpha: 1.0
    Draw Priority: 2
    Frame Locked: true
  - Class: rviz_default_plugins/Path
    Name: Planned path
    Enabled: true
    Topic:
      Value: /pb/path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 2
    Color: 0; 80; 255
    Line Style: Billboards
    Line Width: 0.04
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.12
  - Class: rviz_default_plugins/Marker
    Name: First path issue (amber unknown / red obstacle)
    Enabled: true
    Topic:
      Value: /pb/path_issue
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 2
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetGoal
    Topic: /pb/plan_goal
  - Class: rviz_default_plugins/PublishPoint
    Topic: /clicked_point
    Single click: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 65
      X: 0.0
      Y: 0.0
      Angle: -1.5707963267948966
Window Geometry:
  Width: 1400
  Height: 900
